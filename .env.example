# Copy to .env and fill in. .env is git-ignored.
SITE_URL=https://eatecconstruction.com

# First start only: creates the admin user. Change the password later under Admin > Account.
ADMIN_EMAIL=admin@eatecconstruction.com
ADMIN_PASSWORD=change-this-long-password

# Optional: send contact form messages by email (messages are always saved in the admin panel).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@eatecconstruction.com
# CONTACT_TO=office@eatecconstruction.com

# Behind one reverse proxy (nginx, Traefik, ingress) this should stay 1.
# TRUST_PROXY=1
